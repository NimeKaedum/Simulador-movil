[sub_resource type="GDScript" id="GDScript_mrob4"]
script/source = "extends Control

var parent
var paloma

func _on_cerrar_pressed():
	hide()

func _on_salir_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Verde\"
	paloma = $Si1
	palomas(paloma)

func _on_h_1_pressed():
	get_tree().quit()

func _on_h_3_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Rosa\"
	paloma = $Si3
	palomas(paloma)

func _on_c_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Azul\"
	paloma = $Si6
	palomas(paloma)

func _on_c_3_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Rojo\"
	paloma = $Si8
	palomas(paloma)

func _on_p_1_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Larga\"
	paloma = $Si11
	palomas(paloma)

func _on_p_2_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Canon\"
	paloma = $Si12
	palomas(paloma)

func _on_p_3_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Gorda\"
	paloma = $Si13
	palomas(paloma)

func _on_p_4_pressed():
	parent = get_tree().get_root().get_node(\"Node2D\")
	parent.prueba = \"Fake\"
	paloma = $Si14
	palomas(paloma)

func palomas(chida):
	$Si1.hide()
	$Si3.hide()
	$Si6.hide()
	$Si8.hide()
	$Si11.hide()
	$Si12.hide()
	$Si13.hide()
	$Si14.hide()
	chida.show()
	
"

